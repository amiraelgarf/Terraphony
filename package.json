{
  "name": "earth-information-jukebox",
  "private": true,
  "version": "1.0.0",
  "description": "Ocean in Motion — a listening observatory for NASA SVS 3912 (Space Apps 2026)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pipeline": "python scripts/run_pipeline.py"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/instrument-serif": "^5.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
